<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net8.0-windows</TargetFramework>
    <RootNamespace>DataVortex.Core</RootNamespace>
    <AssemblyName>DataVortex.Core</AssemblyName>
  </PropertyGroup>

  <ItemGroup>
    <!-- Telegram MTProto user client -->
    <PackageReference Include="WTelegramClient" Version="4.4.5" />
    <!-- ZIP / RAR / 7z reading in pure managed code (replaces SharpZipLib, which cannot read RAR/7z) -->
    <PackageReference Include="SharpCompress" Version="0.49.1" />
    <!-- Logging abstraction (implemented by Serilog in the App layer) -->
    <PackageReference Include="Microsoft.Extensions.Logging.Abstractions" Version="8.0.2" />
    <!-- DPAPI for protecting stored credentials at rest -->
    <PackageReference Include="System.Security.Cryptography.ProtectedData" Version="8.0.0" />
    <!-- Embedded SQLite store for metadata + dedup (scales far better than one JSON file per record) -->
    <PackageReference Include="Microsoft.Data.Sqlite" Version="8.0.10" />
  </ItemGroup>

  <ItemGroup>
    <!-- Portable licensing primitives shared with the licence server (token, fingerprint, signing). -->
    <ProjectReference Include="..\DataVortex.Licensing\DataVortex.Licensing.csproj" />
  </ItemGroup>

  <!-- Build-time injection of the app HMAC key (a secret — NEVER committed). Provide it with -p:DvHmacKey=<key>
       (publish.ps1 does this) or the DV_HMAC_KEY env var. When absent (dev), no attribute is emitted and
       LicensingConstants.AppHmacKey reads back "" ⇒ request signing is disabled. -->
  <PropertyGroup>
    <DvHmacKey Condition="'$(DvHmacKey)' == ''">$(DV_HMAC_KEY)</DvHmacKey>
  </PropertyGroup>
  <ItemGroup Condition="'$(DvHmacKey)' != ''">
    <AssemblyAttribute Include="System.Reflection.AssemblyMetadataAttribute">
      <_Parameter1>DvHmacKey</_Parameter1>
      <_Parameter2>$(DvHmacKey)</_Parameter2>
    </AssemblyAttribute>
  </ItemGroup>

</Project>
