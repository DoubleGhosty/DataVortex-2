<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- Cinematic Dark Ops — Dark palette -->
    <Color x:Key="BgColor">#08090C</Color>
    <Color x:Key="AccentColor">#5E6AD2</Color>

    <SolidColorBrush x:Key="Bg"             Color="#08090C"/>
    <SolidColorBrush x:Key="BgPanel"        Color="#0E1017"/>
    <SolidColorBrush x:Key="BgCard"         Color="#141620"/>
    <SolidColorBrush x:Key="BgCardHover"    Color="#1A1D2B"/>
    <SolidColorBrush x:Key="BgElevated"     Color="#1E2133"/>
    <SolidColorBrush x:Key="Divider"        Color="#1E2133"/>
    <SolidColorBrush x:Key="TextPrimary"    Color="#EDEDEF"/>
    <SolidColorBrush x:Key="TextSecondary"  Color="#8A8F98"/>
    <SolidColorBrush x:Key="Accent"         Color="#5E6AD2"/>
    <SolidColorBrush x:Key="AccentHover"    Color="#7B85E0"/>
    <SolidColorBrush x:Key="AccentSubtle"   Color="#1A1B3A"/>
    <SolidColorBrush x:Key="OnAccent"       Color="#FFFFFF"/>
    <SolidColorBrush x:Key="Cyan"           Color="#00D4FF"/>
    <SolidColorBrush x:Key="Success"        Color="#34D399"/>
    <SolidColorBrush x:Key="Warning"        Color="#FBBF24"/>
    <SolidColorBrush x:Key="Error"          Color="#F87171"/>
    <SolidColorBrush x:Key="Muted"          Color="#4B5063"/>

</ResourceDictionary>
