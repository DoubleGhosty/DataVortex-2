<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- Graphite Operations — Dark palette -->
    <Color x:Key="BgColor">#0A0C10</Color>
    <Color x:Key="AccentColor">#3D7BFF</Color>

    <SolidColorBrush x:Key="Bg"             Color="#0A0C10"/>
    <SolidColorBrush x:Key="BgPanel"        Color="#0F131A"/>
    <SolidColorBrush x:Key="BgCard"         Color="#161B24"/>
    <SolidColorBrush x:Key="BgCardHover"    Color="#1C222D"/>
    <SolidColorBrush x:Key="BgElevated"     Color="#1C222D"/>
    <SolidColorBrush x:Key="Divider"        Color="#242B37"/>
    <SolidColorBrush x:Key="TextPrimary"    Color="#E7EAF0"/>
    <SolidColorBrush x:Key="TextSecondary"  Color="#868E9C"/>
    <SolidColorBrush x:Key="Accent"         Color="#3D7BFF"/>
    <SolidColorBrush x:Key="AccentHover"    Color="#5B90FF"/>
    <SolidColorBrush x:Key="AccentSubtle"   Color="#17233E"/>
    <SolidColorBrush x:Key="OnAccent"       Color="#FFFFFF"/>
    <SolidColorBrush x:Key="Cyan"           Color="#3D7BFF"/>
    <SolidColorBrush x:Key="Success"        Color="#3FB984"/>
    <SolidColorBrush x:Key="Warning"        Color="#E0A23B"/>
    <SolidColorBrush x:Key="Error"          Color="#E5645C"/>
    <SolidColorBrush x:Key="Muted"          Color="#565E6C"/>

</ResourceDictionary>
