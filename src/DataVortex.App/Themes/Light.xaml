<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- Cinematic Dark Ops — Light palette -->
    <Color x:Key="BgColor">#F4F5F8</Color>
    <Color x:Key="AccentColor">#4A54B5</Color>

    <SolidColorBrush x:Key="Bg"             Color="#F4F5F8"/>
    <SolidColorBrush x:Key="BgPanel"        Color="#FFFFFF"/>
    <SolidColorBrush x:Key="BgCard"         Color="#FFFFFF"/>
    <SolidColorBrush x:Key="BgCardHover"    Color="#EDEEF4"/>
    <SolidColorBrush x:Key="BgElevated"     Color="#FFFFFF"/>
    <SolidColorBrush x:Key="Divider"        Color="#E2E5ED"/>
    <SolidColorBrush x:Key="TextPrimary"    Color="#141620"/>
    <SolidColorBrush x:Key="TextSecondary"  Color="#5B626E"/>
    <SolidColorBrush x:Key="Accent"         Color="#4A54B5"/>
    <SolidColorBrush x:Key="AccentHover"    Color="#3B44A0"/>
    <SolidColorBrush x:Key="AccentSubtle"   Color="#E8E9F5"/>
    <SolidColorBrush x:Key="OnAccent"       Color="#FFFFFF"/>
    <SolidColorBrush x:Key="Cyan"           Color="#0891B2"/>
    <SolidColorBrush x:Key="Success"        Color="#059669"/>
    <SolidColorBrush x:Key="Warning"        Color="#D97706"/>
    <SolidColorBrush x:Key="Error"          Color="#DC2626"/>
    <SolidColorBrush x:Key="Muted"          Color="#9CA3AF"/>

</ResourceDictionary>
