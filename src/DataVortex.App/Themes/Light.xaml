<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- Graphite Operations — Light palette -->
    <Color x:Key="BgColor">#F4F6F9</Color>
    <Color x:Key="AccentColor">#2563EB</Color>

    <SolidColorBrush x:Key="Bg"             Color="#F4F6F9"/>
    <SolidColorBrush x:Key="BgPanel"        Color="#FFFFFF"/>
    <SolidColorBrush x:Key="BgCard"         Color="#FFFFFF"/>
    <SolidColorBrush x:Key="BgCardHover"    Color="#EEF1F6"/>
    <SolidColorBrush x:Key="BgElevated"     Color="#EEF1F6"/>
    <SolidColorBrush x:Key="Divider"        Color="#E2E6EE"/>
    <SolidColorBrush x:Key="TextPrimary"    Color="#131722"/>
    <SolidColorBrush x:Key="TextSecondary"  Color="#5B626E"/>
    <SolidColorBrush x:Key="Accent"         Color="#2563EB"/>
    <SolidColorBrush x:Key="AccentHover"    Color="#1D4FD7"/>
    <SolidColorBrush x:Key="AccentSubtle"   Color="#E7EDFD"/>
    <SolidColorBrush x:Key="OnAccent"       Color="#FFFFFF"/>
    <SolidColorBrush x:Key="Cyan"           Color="#2563EB"/>
    <SolidColorBrush x:Key="Success"        Color="#128A5B"/>
    <SolidColorBrush x:Key="Warning"        Color="#B7791F"/>
    <SolidColorBrush x:Key="Error"          Color="#D14B43"/>
    <SolidColorBrush x:Key="Muted"          Color="#8A909C"/>

</ResourceDictionary>
