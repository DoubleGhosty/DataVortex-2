<UserControl x:Class="DataVortex.App.Views.LogView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             FontFamily="Segoe UI"
             TextElement.Foreground="{DynamicResource TextPrimary}">

    <Grid Margin="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <DockPanel Grid.Row="0" Margin="0,0,0,14">
            <TextBlock Text="Logs" Style="{StaticResource Title}" DockPanel.Dock="Left"/>
            <Button Content="Clear" Style="{StaticResource Ghost}" Command="{Binding ClearCommand}"
                    DockPanel.Dock="Right" HorizontalAlignment="Right"/>
        </DockPanel>

        <Border Grid.Row="1" Style="{StaticResource Card}" Padding="10">
            <ListBox x:Name="LogList" ItemsSource="{Binding Entries}" Background="Transparent" BorderThickness="0"
                     ScrollViewer.HorizontalScrollBarVisibility="Disabled" ScrollViewer.VerticalScrollBarVisibility="Auto">
                <ListBox.ItemContainerStyle>
                    <Style TargetType="ListBoxItem">
                        <Setter Property="Padding" Value="2,3"/>
                        <Setter Property="Background" Value="Transparent"/>
                        <Setter Property="BorderThickness" Value="0"/>
                        <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
                    </Style>
                </ListBox.ItemContainerStyle>
                <ListBox.ItemTemplate>
                    <DataTemplate>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="72"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="{Binding Timestamp, StringFormat=HH:mm:ss.fff}"
                                       FontFamily="JetBrains Mono, Cascadia Mono, Consolas" FontSize="12"
                                       Foreground="{DynamicResource Muted}"/>
                            <TextBlock Grid.Column="1" Text="{Binding Level}"
                                       FontFamily="JetBrains Mono, Cascadia Mono, Consolas" FontSize="12" Margin="10,0"
                                       FontWeight="Medium"
                                       Foreground="{Binding Level, Converter={StaticResource StatusBrush}}"/>
                            <TextBlock Grid.Column="2" Text="{Binding Message}"
                                       FontFamily="JetBrains Mono, Cascadia Mono, Consolas" FontSize="12"
                                       TextWrapping="Wrap" Foreground="{DynamicResource TextSecondary}"/>
                        </Grid>
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>
        </Border>
    </Grid>
</UserControl>
