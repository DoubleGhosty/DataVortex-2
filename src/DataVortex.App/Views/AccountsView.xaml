<UserControl x:Class="DataVortex.App.Views.AccountsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             FontFamily="Segoe UI"
             TextElement.Foreground="{DynamicResource TextPrimary}">

    <Grid Margin="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0" Text="Accounts" Style="{StaticResource Title}"/>

        <Border Grid.Row="1" Style="{StaticResource Card}" Padding="14" Margin="0,14,0,0">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>
                <DockPanel Grid.Row="0" Margin="0,0,0,14" LastChildFill="False">
                    <TextBlock Text="Passculture accounts found:" Style="{StaticResource Caption}" DockPanel.Dock="Left"
                               VerticalAlignment="Center"/>
                    <Border Style="{StaticResource StatusBadge}" DockPanel.Dock="Left" Margin="10,0,0,0">
                        <TextBlock Text="{Binding AccountCount, StringFormat='{}{0} account(s)'}" FontSize="13" FontWeight="SemiBold"
                                   Foreground="{DynamicResource Accent}"/>
                    </Border>
                    <TextBlock Text="Captchas 2captcha :" Style="{StaticResource Caption}" DockPanel.Dock="Left"
                               VerticalAlignment="Center" Margin="18,0,0,0"/>
                    <Border Style="{StaticResource StatusBadge}" DockPanel.Dock="Left" Margin="10,0,0,0">
                        <TextBlock Text="{Binding CaptchaRequests}" FontSize="13" FontWeight="SemiBold"
                                   Foreground="{DynamicResource Warning}"/>
                    </Border>
                    <Button Content="Importer combolist" Command="{Binding ImportComboListCommand}" DockPanel.Dock="Right"/>
                    <Button Content="⚠ RE-TESTER TOUT" Style="{StaticResource Danger}" Command="{Binding RetestAllAccountsCommand}"
                            DockPanel.Dock="Right" Margin="0,0,16,0"
                            ToolTip="Supprime tous les résultats et reteste chaque compte via une vraie connexion (1 captcha/compte). Irréversible."/>
                    <Button Content="Stop" Style="{StaticResource Ghost}" Command="{Binding StopCheckerCommand}"
                            DockPanel.Dock="Right" Margin="0,0,8,0" IsEnabled="{Binding IsChecking}"/>
                    <Button Content="Revérifier comptes" Style="{StaticResource Ghost}" Command="{Binding RefreshCreditsCommand}"
                            DockPanel.Dock="Right" Margin="0,0,8,0"
                            ToolTip="Revérifie crédit + statut (EXPIRE) + suspension de tous les comptes valides, via refresh token (0 captcha)."/>
                    <Button Content="Tester les comptes" Style="{StaticResource Ghost}" Command="{Binding TestAccountsCommand}"
                            DockPanel.Dock="Right" Margin="0,0,8,0"/>
                </DockPanel>

                <DockPanel Grid.Row="1" Margin="0,0,0,12" LastChildFill="False">
                    <StackPanel Orientation="Horizontal" DockPanel.Dock="Left" VerticalAlignment="Center">
                        <TextBlock Text="Filtrer :" Style="{StaticResource Caption}" VerticalAlignment="Center" Margin="0,0,12,0"/>
                        <CheckBox IsChecked="{Binding ShowValid}" Margin="0,0,16,0" FontWeight="SemiBold" Foreground="{DynamicResource Success}"
                                  Content="{Binding CountValid, StringFormat='VALIDE : {0}'}"/>
                        <CheckBox IsChecked="{Binding ShowBan}" Margin="0,0,16,0" FontWeight="SemiBold" Foreground="{DynamicResource Error}"
                                  Content="{Binding CountBan, StringFormat='BAN : {0}'}"/>
                        <CheckBox IsChecked="{Binding ShowCustom}" Margin="0,0,16,0" FontWeight="SemiBold" Foreground="{DynamicResource Warning}"
                                  Content="{Binding CountCustom, StringFormat='CUSTOM : {0}'}"/>
                        <CheckBox IsChecked="{Binding ShowExpire}" Margin="0,0,16,0" FontWeight="SemiBold" Foreground="{DynamicResource TextSecondary}"
                                  Content="{Binding CountExpire, StringFormat='EXPIRE : {0}'}"/>
                        <Border Style="{StaticResource StatusBadge}" Margin="8,0,0,0">
                            <TextBlock FontSize="12" FontWeight="SemiBold" Foreground="{DynamicResource TextSecondary}"
                                       Text="{Binding CountRetry, StringFormat='RETRY : {0}'}"/>
                        </Border>
                    </StackPanel>

                    <StackPanel Orientation="Horizontal" DockPanel.Dock="Right" VerticalAlignment="Center">
                        <Button Content="◀" Style="{StaticResource Ghost}" Padding="10,3" Command="{Binding PrevPageCommand}"
                                IsEnabled="{Binding CanPrev}"/>
                        <TextBlock Text="{Binding PageInfo}" Style="{StaticResource Caption}" VerticalAlignment="Center" Margin="8,0"/>
                        <Button Content="▶" Style="{StaticResource Ghost}" Padding="10,3" Command="{Binding NextPageCommand}"
                                IsEnabled="{Binding CanNext}" Margin="0,0,16,0"/>
                        <TextBlock Text="Recherche email :" Style="{StaticResource Caption}" VerticalAlignment="Center" Margin="0,0,8,0"/>
                        <TextBox Width="220" VerticalContentAlignment="Center"
                                 Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged, Delay=250}"/>
                    </StackPanel>
                </DockPanel>

                <DataGrid Grid.Row="2" ItemsSource="{Binding Accounts}" AutoGenerateColumns="False" IsReadOnly="True">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="Catégorie" Binding="{Binding Category}" Width="90"/>
                        <DataGridTextColumn Header="Username" Binding="{Binding Username}" Width="*"/>
                        <DataGridTextColumn Header="Password" Binding="{Binding Password}" Width="*"/>
                        <DataGridTextColumn Header="Credit (€)" Binding="{Binding CreditDisplay}" Width="110"/>
                        <DataGridTextColumn Header="BirthDate" Binding="{Binding BirthDate}" Width="120"/>
                        <DataGridTextColumn Header="Tested" Binding="{Binding Tested}" Width="80"/>
                        <DataGridTemplateColumn Header="AccessToken" Width="120">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <Button Content="Copy" Style="{StaticResource Ghost}" Padding="8,4" FontSize="11"
                                            Command="{Binding DataContext.CopyAccessTokenCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                            CommandParameter="{Binding}"/>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                        <DataGridTemplateColumn Header="RefreshToken" Width="120">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <Button Content="Copy" Style="{StaticResource Ghost}" Padding="8,4" FontSize="11"
                                            Command="{Binding DataContext.CopyRefreshTokenCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                            CommandParameter="{Binding}"/>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                    </DataGrid.Columns>
                </DataGrid>

                <ScrollViewer Grid.Row="3" MaxHeight="120" VerticalScrollBarVisibility="Auto" Margin="0,10,0,0">
                    <TextBlock Text="{Binding StatusText}" Style="{StaticResource Caption}" TextWrapping="Wrap"/>
                </ScrollViewer>
            </Grid>
        </Border>
    </Grid>
</UserControl>
