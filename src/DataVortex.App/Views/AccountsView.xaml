<UserControl x:Class="DataVortex.App.Views.AccountsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             FontFamily="Segoe UI"
             TextElement.Foreground="{DynamicResource TextPrimary}">

    <Grid Margin="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0">
            <TextBlock Text="Accounts" Style="{StaticResource Title}"/>
            <TextBlock Style="{StaticResource Caption}" Margin="0,4,0,0"
                       Text="Passculture credentials found across archives and combolists."/>
        </StackPanel>

        <Border Grid.Row="1" Style="{StaticResource Card}" Padding="14" Margin="0,14,0,0">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <!-- Row 0: counters + actions -->
                <DockPanel Grid.Row="0" Margin="0,0,0,14" LastChildFill="False">
                    <StackPanel Orientation="Horizontal" DockPanel.Dock="Left" VerticalAlignment="Center">
                        <TextBlock Text="Accounts" Style="{StaticResource Caption}" VerticalAlignment="Center"/>
                        <Border Style="{StaticResource StatusBadge}" Margin="8,0,0,0">
                            <TextBlock Text="{Binding AccountCount}" FontSize="13" FontWeight="SemiBold"
                                       Foreground="{DynamicResource Accent}"/>
                        </Border>
                        <TextBlock Text="Captchas" Style="{StaticResource Caption}" VerticalAlignment="Center" Margin="18,0,0,0"/>
                        <Border Style="{StaticResource StatusBadge}" Margin="8,0,0,0">
                            <TextBlock Text="{Binding CaptchaRequests}" FontSize="13" FontWeight="SemiBold"
                                       Foreground="{DynamicResource Warning}"/>
                        </Border>
                    </StackPanel>

                    <StackPanel Orientation="Horizontal" DockPanel.Dock="Right" VerticalAlignment="Center">
                        <TextBlock Text="Test (captcha):" Style="{StaticResource Caption}" VerticalAlignment="Center" Margin="0,0,8,0"/>
                        <Button Content="Archives" Style="{StaticResource Ghost}" Command="{Binding TestAccountsCommand}"
                                Margin="0,0,8,0" ToolTip="Test the accounts found in archives / extracted files (1 captcha per new account)."/>
                        <Button Content="Combolist…" Command="{Binding ImportComboListCommand}"
                                ToolTip="Import a mail:pass .txt file and test each line (1 captcha per new account)."/>

                        <Border Width="1" Margin="14,2,14,2" Background="{DynamicResource Divider}"/>

                        <Button Content="Re-verify" Style="{StaticResource Ghost}" Command="{Binding RefreshCreditsCommand}"
                                Margin="0,0,8,0"
                                ToolTip="Re-verify every non-INVALID account via the refresh token (0 captcha). If the refresh is rejected (401, password maybe changed), a real sign-in WITH captcha is attempted → reclassifies the account or marks it INVALID."/>
                        <Button Content="Reactivate RECUP" Style="{StaticResource Ghost}" Command="{Binding ReactivateAllRecupCommand}"
                                Margin="0,0,8,0"
                                ToolTip="Try to reactivate every RECUP account (reversible suspension) via /account/unsuspend. Refresh token first (0 captcha)."/>
                        <Button Content="⚠ Retest all" Style="{StaticResource Danger}" Command="{Binding RetestAllAccountsCommand}"
                                ToolTip="DANGER: deletes all results and re-tests every account via a real sign-in (1 captcha/account). Irreversible."/>

                        <Border Width="1" Margin="14,2,14,2" Background="{DynamicResource Divider}"/>

                        <Button Content="Stop" Style="{StaticResource Ghost}" Command="{Binding StopCheckerCommand}"
                                IsEnabled="{Binding IsChecking}" ToolTip="Cancel the running operation."/>
                    </StackPanel>
                </DockPanel>

                <!-- Row 1: filter chips -->
                <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="0,0,0,12">
                    <TextBlock Text="Filter" Style="{StaticResource Caption}" VerticalAlignment="Center" Margin="0,0,12,0"/>
                    <CheckBox Style="{StaticResource Chip}" Tag="{DynamicResource Success}" IsChecked="{Binding ShowValid}"
                              Margin="0,0,8,0" Content="{Binding CountValid, StringFormat='Valid  {0}'}"/>
                    <CheckBox Style="{StaticResource Chip}" Tag="{DynamicResource Error}" IsChecked="{Binding ShowBan}"
                              Margin="0,0,8,0" Content="{Binding CountBan, StringFormat='Ban  {0}'}"/>
                    <CheckBox Style="{StaticResource Chip}" Tag="{DynamicResource Warning}" IsChecked="{Binding ShowCustom}"
                              Margin="0,0,8,0" Content="{Binding CountCustom, StringFormat='Custom  {0}'}"/>
                    <CheckBox Style="{StaticResource Chip}" Tag="{DynamicResource Muted}" IsChecked="{Binding ShowExpire}"
                              Margin="0,0,8,0" Content="{Binding CountExpire, StringFormat='Expired  {0}'}"/>
                    <CheckBox Style="{StaticResource Chip}" Tag="{DynamicResource Accent}" IsChecked="{Binding ShowRecup}"
                              Margin="0,0,8,0" Content="{Binding CountRecup, StringFormat='Recup  {0}'}"
                              ToolTip="Reversible suspensions (UPON_USER_REQUEST / login report) — reactivatable."/>
                    <CheckBox Style="{StaticResource Chip}" Tag="{DynamicResource Muted}" IsChecked="{Binding ShowInactive}"
                              Margin="0,0,8,0" Content="{Binding CountInactive, StringFormat='Inactive  {0}'}"
                              ToolTip="Generic inactive accounts (isActive=False) — neither banned nor confirmed usable."/>
                    <Border Style="{StaticResource StatusBadge}" VerticalAlignment="Center">
                        <TextBlock FontSize="12" FontWeight="SemiBold" Foreground="{DynamicResource TextSecondary}"
                                   Text="{Binding CountRetry, StringFormat='Retry  {0}'}"/>
                    </Border>
                </StackPanel>

                <!-- Row 2: pagination + search -->
                <DockPanel Grid.Row="2" Margin="0,0,0,12" LastChildFill="False">
                    <StackPanel Orientation="Horizontal" DockPanel.Dock="Right" VerticalAlignment="Center">
                        <Button Content="◀" Style="{StaticResource Ghost}" Padding="10,3" Command="{Binding PrevPageCommand}"
                                IsEnabled="{Binding CanPrev}"/>
                        <TextBlock Text="{Binding PageInfo}" Style="{StaticResource Caption}" VerticalAlignment="Center" Margin="8,0"/>
                        <Button Content="▶" Style="{StaticResource Ghost}" Padding="10,3" Command="{Binding NextPageCommand}"
                                IsEnabled="{Binding CanNext}" Margin="0,0,16,0"/>
                        <TextBlock Text="Search email:" Style="{StaticResource Caption}" VerticalAlignment="Center" Margin="0,0,8,0"/>
                        <TextBox Width="220" VerticalContentAlignment="Center"
                                 Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged, Delay=250}"/>
                    </StackPanel>
                </DockPanel>

                <!-- Row 3: grid -->
                <DataGrid Grid.Row="3" ItemsSource="{Binding Accounts}" AutoGenerateColumns="False" IsReadOnly="True">
                    <DataGrid.Columns>
                        <DataGridTemplateColumn Header="Status" Width="110" SortMemberPath="Category">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <Border Style="{StaticResource StatusTag}">
                                        <StackPanel Orientation="Horizontal">
                                            <Ellipse Width="7" Height="7" VerticalAlignment="Center" Margin="0,0,6,0"
                                                     Fill="{Binding Category, Converter={StaticResource CategoryBrush}}"/>
                                            <TextBlock Text="{Binding Category, Converter={StaticResource CategoryLabel}}"
                                                       FontSize="11" FontWeight="SemiBold"
                                                       Foreground="{Binding Category, Converter={StaticResource CategoryBrush}}"/>
                                        </StackPanel>
                                    </Border>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                        <DataGridTextColumn Header="Email" Binding="{Binding Username}" Width="*"/>
                        <DataGridTextColumn Header="Password" Binding="{Binding Password}" Width="*"/>
                        <DataGridTextColumn Header="Credit (€)" Binding="{Binding CreditDisplay}" Width="110"/>
                        <DataGridTextColumn Header="Birth date" Binding="{Binding BirthDate}" Width="120"/>
                        <DataGridTextColumn Header="Tested" Binding="{Binding Tested}" Width="80"/>
                        <DataGridTemplateColumn Header="Session" Width="120">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <Button Content="Open" Style="{StaticResource Ghost}" Padding="8,4" FontSize="11"
                                            Command="{Binding DataContext.OpenSessionCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                            CommandParameter="{Binding}"
                                            ToolTip="Open Chrome already signed into this account (fresh token injected)."/>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                        <DataGridTemplateColumn Header="Reactivate" Width="110">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <Button Content="Reactivate" Padding="8,4" FontSize="11"
                                            Command="{Binding DataContext.ReactivateAccountCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                            CommandParameter="{Binding}"
                                            ToolTip="Lift this account's reversible suspension (unsuspend). 0 captcha if the refresh token is still valid.">
                                        <Button.Style>
                                            <Style TargetType="Button" BasedOn="{StaticResource Ghost}">
                                                <Setter Property="Visibility" Value="Collapsed"/>
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding Category}" Value="RECUP">
                                                        <Setter Property="Visibility" Value="Visible"/>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </Button.Style>
                                    </Button>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                    </DataGrid.Columns>
                </DataGrid>

                <!-- Row 4: status line -->
                <ScrollViewer Grid.Row="4" MaxHeight="120" VerticalScrollBarVisibility="Auto" Margin="0,10,0,0">
                    <TextBlock Text="{Binding StatusText}" Style="{StaticResource Caption}" TextWrapping="Wrap"/>
                </ScrollViewer>
            </Grid>
        </Border>
    </Grid>
</UserControl>
