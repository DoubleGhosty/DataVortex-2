<Window x:Class="DataVortex.App.Views.ShellWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="DataVortex — Telegram Archiver"
        Height="780" Width="1200" MinHeight="560" MinWidth="940"
        WindowStartupLocation="CenterScreen"
        FontFamily="Segoe UI"
        Background="{DynamicResource Bg}"
        TextElement.Foreground="{DynamicResource TextPrimary}"
        TextOptions.TextFormattingMode="Ideal"
        TextOptions.TextRenderingMode="ClearType">

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="Auto"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <!-- ===================== Navigation Rail ===================== -->
        <Border Grid.Column="0" Background="{DynamicResource BgPanel}" BorderBrush="{DynamicResource Divider}" BorderThickness="0,0,1,0"
                Width="220">
            <DockPanel>
                <!-- App header -->
                <Border DockPanel.Dock="Top" Padding="18,18,18,14">
                    <StackPanel>
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="&#xE943;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" FontSize="20"
                                       Foreground="{DynamicResource Accent}" VerticalAlignment="Center" Margin="0,0,10,0"/>
                            <TextBlock Text="DataVortex" FontSize="18" FontWeight="Bold" Foreground="{DynamicResource TextPrimary}"/>
                        </StackPanel>
                        <TextBlock Text="Telegram archiver" FontSize="11" Foreground="{DynamicResource TextSecondary}" Margin="0,4,0,0"/>
                    </StackPanel>
                </Border>

                <!-- Divider -->
                <Border DockPanel.Dock="Top" Height="1" Background="{DynamicResource Divider}" Margin="16,0"/>

                <!-- Connection status (bottom) -->
                <Border DockPanel.Dock="Bottom" Padding="14,12">
                    <Border Background="{DynamicResource BgCard}" CornerRadius="10" Padding="12,10"
                            BorderBrush="{DynamicResource Divider}" BorderThickness="1">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <Ellipse Width="8" Height="8" VerticalAlignment="Center"
                                     Fill="{Binding Connection, Converter={StaticResource StatusBrush}}"/>
                            <TextBlock Text="{Binding ConnectionText}" Margin="8,0,0,0" FontSize="12"
                                       Foreground="{DynamicResource TextPrimary}" VerticalAlignment="Center"/>
                            <TextBlock Text="{Binding UserName}" Margin="6,0,0,0" FontSize="11"
                                       Foreground="{DynamicResource TextSecondary}" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Border>
                </Border>

                <!-- Bottom toolbar -->
                <Border DockPanel.Dock="Bottom" Padding="14,0,14,4">
                    <UniformGrid Columns="5">
                        <Button Content="{Binding PauseLabel}" Style="{StaticResource Ghost}" Command="{Binding TogglePauseCommand}"
                                FontSize="11" Padding="4,6"/>
                        <Button Content="&#xE771;" Style="{StaticResource IconButton}" Command="{Binding ToggleThemeCommand}"
                                ToolTip="Toggle theme"/>
                        <Button Content="&#xED25;" Style="{StaticResource IconButton}" Command="{Binding OpenDataFolderCommand}"
                                ToolTip="Data folder"/>
                        <Button Content="&#xE74D;" Style="{StaticResource IconButton}" Command="{Binding ClearDedupCommand}"
                                ToolTip="Clear dedup"/>
                        <Button Content="&#xE77B;" Style="{StaticResource IconButton}" Command="{Binding LoginCommand}"
                                IsEnabled="{Binding CanOpenLogin}" ToolTip="Login"/>
                    </UniformGrid>
                </Border>

                <Border DockPanel.Dock="Bottom" Height="1" Background="{DynamicResource Divider}" Margin="16,0,16,4"/>

                <!-- Nav items -->
                <ListBox ItemsSource="{Binding Sections}" SelectedItem="{Binding SelectedSection, Mode=TwoWay}"
                         Background="Transparent" BorderThickness="0" Padding="8,12"
                         ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                    <ListBox.ItemContainerStyle>
                        <Style TargetType="ListBoxItem">
                            <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                            <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
                            <Setter Property="Template">
                                <Setter.Value>
                                    <ControlTemplate TargetType="ListBoxItem">
                                        <Border x:Name="b" Background="Transparent" CornerRadius="10" Margin="4,2" Padding="0"
                                                Cursor="Hand">
                                            <Grid Height="40">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="44"/>
                                                    <ColumnDefinition Width="*"/>
                                                </Grid.ColumnDefinitions>
                                                <TextBlock Grid.Column="0" Text="{Binding Glyph}"
                                                           FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" FontSize="15"
                                                           HorizontalAlignment="Center" VerticalAlignment="Center"
                                                           x:Name="icon" Foreground="{DynamicResource TextSecondary}"/>
                                                <TextBlock Grid.Column="1" Text="{Binding Name}" VerticalAlignment="Center"
                                                           x:Name="t" FontSize="13" Foreground="{DynamicResource TextSecondary}"/>
                                            </Grid>
                                        </Border>
                                        <ControlTemplate.Triggers>
                                            <Trigger Property="IsMouseOver" Value="True">
                                                <Setter TargetName="b" Property="Background" Value="{DynamicResource BgCardHover}"/>
                                            </Trigger>
                                            <Trigger Property="IsSelected" Value="True">
                                                <Setter TargetName="b" Property="Background" Value="{DynamicResource AccentSubtle}"/>
                                                <Setter TargetName="icon" Property="Foreground" Value="{DynamicResource Accent}"/>
                                                <Setter TargetName="t" Property="Foreground" Value="{DynamicResource TextPrimary}"/>
                                                <Setter TargetName="t" Property="FontWeight" Value="SemiBold"/>
                                            </Trigger>
                                        </ControlTemplate.Triggers>
                                    </ControlTemplate>
                                </Setter.Value>
                            </Setter>
                        </Style>
                    </ListBox.ItemContainerStyle>
                </ListBox>
            </DockPanel>
        </Border>

        <!-- ===================== Content host ===================== -->
        <ContentControl Grid.Column="1" Content="{Binding SelectedSection.ViewModel}" Margin="0"/>
    </Grid>
</Window>
