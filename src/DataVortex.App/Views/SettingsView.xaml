<UserControl x:Class="DataVortex.App.Views.SettingsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             FontFamily="Segoe UI"
             TextElement.Foreground="{DynamicResource TextPrimary}">

    <Grid Margin="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Header -->
        <StackPanel Grid.Row="0">
            <TextBlock Text="Settings" Style="{StaticResource Title}"/>
            <TextBlock Style="{StaticResource Caption}" Margin="0,4,0,0" TextWrapping="Wrap"
                       Text="Modifie la configuration sans editer settings.json. La plupart des reglages s'appliquent immediatement."/>
        </StackPanel>

        <!-- Sections -->
        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" Margin="0,20,0,0" Padding="0,0,8,0">
            <StackPanel>

                <!-- Pipeline -->
                <Border Style="{StaticResource Card}" Margin="0,0,0,14">
                    <StackPanel>
                        <DockPanel Margin="0,0,0,6">
                            <TextBlock Text="Pipeline" Style="{StaticResource SectionHeader}" DockPanel.Dock="Left"/>
                            <Border Style="{StaticResource StatusBadge}" DockPanel.Dock="Left" Margin="10,0,0,0"
                                    Background="{DynamicResource BgElevated}">
                                <TextBlock Text="redemarrage requis" Foreground="{DynamicResource Warning}"
                                           FontSize="10" FontWeight="Medium"/>
                            </Border>
                        </DockPanel>
                        <TextBlock Style="{StaticResource Caption}" Margin="0,0,0,14" TextWrapping="Wrap"
                                   Text="Workers paralleles, capacites des files et politique de retry."/>
                        <WrapPanel>
                            <StackPanel Width="160" Margin="0,0,14,12">
                                <TextBlock Text="Workers download" Style="{StaticResource Caption}" Margin="0,0,0,6"/>
                                <TextBox Text="{Binding MaxParallelDownloads, UpdateSourceTrigger=PropertyChanged}"/>
                            </StackPanel>
                            <StackPanel Width="160" Margin="0,0,14,12">
                                <TextBlock Text="Workers extraction" Style="{StaticResource Caption}" Margin="0,0,0,6"/>
                                <TextBox Text="{Binding MaxParallelProcessing, UpdateSourceTrigger=PropertyChanged}"/>
                            </StackPanel>
                            <StackPanel Width="160" Margin="0,0,14,12">
                                <TextBlock Text="File download (capacite)" Style="{StaticResource Caption}" Margin="0,0,0,6"/>
                                <TextBox Text="{Binding DownloadQueueCapacity, UpdateSourceTrigger=PropertyChanged}"/>
                            </StackPanel>
                            <StackPanel Width="160" Margin="0,0,14,12">
                                <TextBlock Text="File extraction (capacite)" Style="{StaticResource Caption}" Margin="0,0,0,6"/>
                                <TextBox Text="{Binding ProcessingQueueCapacity, UpdateSourceTrigger=PropertyChanged}"/>
                            </StackPanel>
                            <StackPanel Width="160" Margin="0,0,14,12">
                                <TextBlock Text="Retries max" Style="{StaticResource Caption}" Margin="0,0,0,6"/>
                                <TextBox Text="{Binding MaxDownloadRetries, UpdateSourceTrigger=PropertyChanged}"/>
                            </StackPanel>
                            <StackPanel Width="160" Margin="0,0,14,12">
                                <TextBlock Text="Delai de retry (ms)" Style="{StaticResource Caption}" Margin="0,0,0,6"/>
                                <TextBox Text="{Binding RetryBaseDelayMs, UpdateSourceTrigger=PropertyChanged}"/>
                            </StackPanel>
                        </WrapPanel>
                    </StackPanel>
                </Border>

                <!-- Extraction -->
                <Border Style="{StaticResource Card}" Margin="0,0,0,14">
                    <StackPanel>
                        <TextBlock Text="Extraction" Style="{StaticResource SectionHeader}" Margin="0,0,0,6"/>
                        <TextBlock Style="{StaticResource Caption}" Margin="0,0,0,12" TextWrapping="Wrap"
                                   Text="Filtrage des .txt par NOM de fichier (le contenu n'est jamais inspecte)."/>
                        <CheckBox Content="N'extraire que les .txt dont le nom contient un mot-cle"
                                  IsChecked="{Binding ExtractOnlyMatchingTxt}"/>
                        <TextBlock Style="{StaticResource Caption}" Margin="0,14,0,6"
                                   Text="Mots-cles (un par ligne)"/>
                        <TextBox Text="{Binding ExtractKeywords, UpdateSourceTrigger=PropertyChanged}"
                                 AcceptsReturn="True" TextWrapping="Wrap" MinHeight="80"
                                 VerticalContentAlignment="Top" VerticalScrollBarVisibility="Auto"/>
                    </StackPanel>
                </Border>

                <!-- Download filter -->
                <Border Style="{StaticResource Card}" Margin="0,0,0,14">
                    <StackPanel>
                        <TextBlock Text="Telechargement" Style="{StaticResource SectionHeader}" Margin="0,0,0,6"/>
                        <TextBlock Style="{StaticResource Caption}" Margin="0,0,0,10" TextWrapping="Wrap"
                                   Text="Extensions telechargees (une par ligne). Vide = tout telecharger."/>
                        <TextBox Text="{Binding DownloadExtensions, UpdateSourceTrigger=PropertyChanged}"
                                 AcceptsReturn="True" TextWrapping="Wrap" MinHeight="72"
                                 VerticalContentAlignment="Top" VerticalScrollBarVisibility="Auto"/>
                    </StackPanel>
                </Border>

                <!-- Network -->
                <Border Style="{StaticResource Card}" Margin="0,0,0,14">
                    <StackPanel>
                        <TextBlock Text="Reseau" Style="{StaticResource SectionHeader}" Margin="0,0,0,6"/>
                        <TextBlock Style="{StaticResource Caption}" Margin="0,0,0,10" TextWrapping="Wrap"
                                   Text="Limite de bande passante de telechargement. 0 = illimite."/>
                        <StackPanel Orientation="Horizontal">
                            <TextBox Text="{Binding BandwidthMBps, UpdateSourceTrigger=PropertyChanged}" Width="130"/>
                            <TextBlock Text="Mo/s" Style="{StaticResource Caption}" VerticalAlignment="Center" Margin="10,0,0,0"/>
                        </StackPanel>
                        <TextBlock Style="{StaticResource Caption}" Margin="0,16,0,10" TextWrapping="Wrap"
                                   Text="Morceaux telecharges en parallele par fichier (defaut WTelegram = 2). 8-16 accelere fortement sur liaison a forte latence ; trop haut = risque de FLOOD_WAIT. Applique immediatement."/>
                        <StackPanel Orientation="Horizontal">
                            <TextBox Text="{Binding ParallelTransfers, UpdateSourceTrigger=PropertyChanged}" Width="130"/>
                            <TextBlock Text="parties // (1-32)" Style="{StaticResource Caption}" VerticalAlignment="Center" Margin="10,0,0,0"/>
                        </StackPanel>
                    </StackPanel>
                </Border>

                <!-- Backfill -->
                <Border Style="{StaticResource Card}" Margin="0,0,0,14">
                    <StackPanel>
                        <TextBlock Text="Backfill (rattrapage de l'historique)" Style="{StaticResource SectionHeader}" Margin="0,0,0,6"/>
                        <TextBlock Style="{StaticResource Caption}" Margin="0,0,0,12" TextWrapping="Wrap"
                                   Text="Quand le pipeline est inactif, parcourt l'historique des canaux surveilles pour recuperer les anciennes archives."/>
                        <CheckBox Content="Activer le backfill" IsChecked="{Binding BackfillEnabled}"/>
                        <WrapPanel Margin="0,14,0,0">
                            <StackPanel Width="210" Margin="0,0,14,0">
                                <TextBlock Text="Delai d'inactivite (secondes)" Style="{StaticResource Caption}" Margin="0,0,0,6"/>
                                <TextBox Text="{Binding BackfillIdleSeconds, UpdateSourceTrigger=PropertyChanged}"/>
                            </StackPanel>
                            <StackPanel Width="210">
                                <TextBlock Text="Taille de page (1-100)" Style="{StaticResource Caption}" Margin="0,0,0,6"/>
                                <TextBox Text="{Binding BackfillPageSize, UpdateSourceTrigger=PropertyChanged}"/>
                            </StackPanel>
                        </WrapPanel>
                    </StackPanel>
                </Border>

                <!-- Updates -->
                <Border Style="{StaticResource Card}" Margin="0,0,0,14">
                    <StackPanel>
                        <TextBlock Text="Mises a jour" Style="{StaticResource SectionHeader}" Margin="0,0,0,6"/>
                        <TextBlock Text="{Binding CurrentVersionText}" Style="{StaticResource Caption}" Margin="0,0,0,10"/>
                        <StackPanel Orientation="Horizontal">
                            <Button Content="Verifier les mises a jour" Command="{Binding CheckUpdateCommand}" Margin="0,0,10,0"/>
                            <Button Content="Telecharger et installer" Style="{StaticResource Ghost}"
                                    Command="{Binding InstallUpdateCommand}"
                                    Visibility="{Binding UpdateAvailable, Converter={StaticResource BoolToVis}}"/>
                        </StackPanel>
                        <TextBlock Text="{Binding UpdateStatus}" Style="{StaticResource Caption}" Margin="0,10,0,0" TextWrapping="Wrap"/>
                    </StackPanel>
                </Border>

                <!-- Appearance -->
                <Border Style="{StaticResource Card}" Margin="0,0,0,14">
                    <StackPanel>
                        <TextBlock Text="Apparence" Style="{StaticResource SectionHeader}" Margin="0,0,0,10"/>
                        <CheckBox Content="Interface en theme clair" IsChecked="{Binding IsLightTheme}"/>
                    </StackPanel>
                </Border>

                <!-- Account checker -->
                <Border Style="{StaticResource Card}" Margin="0,0,0,14">
                    <StackPanel>
                        <TextBlock Text="Checker (comptes Passculture)" Style="{StaticResource SectionHeader}" Margin="0,0,0,6"/>
                        <TextBlock Style="{StaticResource Caption}" Margin="0,0,0,10" TextWrapping="Wrap"
                                   Text="Nombre de verifications simultanees envoyees au backend (combolist, archives et bouton partagent ce plafond global). Les reponses 429 sont reessayees automatiquement. Applique immediatement."/>
                        <StackPanel Orientation="Horizontal">
                            <TextBox Text="{Binding ParallelAccountChecks, UpdateSourceTrigger=PropertyChanged}" Width="130"/>
                            <TextBlock Text="checks simultanes (1-10)" Style="{StaticResource Caption}" VerticalAlignment="Center" Margin="10,0,0,0"/>
                        </StackPanel>
                    </StackPanel>
                </Border>

                <!-- Proxy (Passculture) -->
                <Border Style="{StaticResource Card}" Margin="0,0,0,14">
                    <StackPanel>
                        <DockPanel Margin="0,0,0,6">
                            <TextBlock Text="Proxy (requetes Passculture)" Style="{StaticResource SectionHeader}" DockPanel.Dock="Left"/>
                            <Border Style="{StaticResource StatusBadge}" DockPanel.Dock="Left" Margin="10,0,0,0"
                                    Background="{DynamicResource BgElevated}">
                                <TextBlock Text="redemarrage requis" Foreground="{DynamicResource Warning}"
                                           FontSize="10" FontWeight="Medium"/>
                            </Border>
                        </DockPanel>
                        <TextBlock Style="{StaticResource Caption}" Margin="0,0,0,10" TextWrapping="Wrap"
                                   Text="Route les requetes vers le backend Passculture via un proxy HTTP (ex. 2captcha residentiel). Identifiants stockes dans settings.json, pas dans le code."/>
                        <CheckBox Content="Activer le proxy" IsChecked="{Binding ProxyEnabled}"/>
                        <TextBlock Text="Adresse (ex. http://na.proxy.2captcha.com:2334)" Style="{StaticResource Caption}" Margin="0,14,0,6"/>
                        <TextBox Text="{Binding ProxyAddress, UpdateSourceTrigger=PropertyChanged}"/>
                        <WrapPanel Margin="0,12,0,0">
                            <StackPanel Width="280" Margin="0,0,14,0">
                                <TextBlock Text="Utilisateur" Style="{StaticResource Caption}" Margin="0,0,0,6"/>
                                <TextBox Text="{Binding ProxyUsername, UpdateSourceTrigger=PropertyChanged}"/>
                            </StackPanel>
                            <StackPanel Width="280">
                                <TextBlock Text="Mot de passe" Style="{StaticResource Caption}" Margin="0,0,0,6"/>
                                <TextBox Text="{Binding ProxyPassword, UpdateSourceTrigger=PropertyChanged}"/>
                            </StackPanel>
                        </WrapPanel>
                    </StackPanel>
                </Border>

                <!-- Passculture / 2captcha -->
                <Border Style="{StaticResource Card}" Margin="0,0,0,0">
                    <StackPanel>
                        <DockPanel Margin="0,0,0,6">
                            <TextBlock Text="Passculture / 2captcha" Style="{StaticResource SectionHeader}" DockPanel.Dock="Left"/>
                            <Border Style="{StaticResource StatusBadge}" DockPanel.Dock="Left" Margin="10,0,0,0"
                                    Background="{DynamicResource BgElevated}">
                                <TextBlock Text="redemarrage requis" Foreground="{DynamicResource Warning}"
                                           FontSize="10" FontWeight="Medium"/>
                            </Border>
                        </DockPanel>
                        <TextBlock Style="{StaticResource Caption}" Margin="0,0,0,10" TextWrapping="Wrap"
                                   Text="Cle API 2captcha utilisee par le module Passculture."/>
                        <TextBox Text="{Binding TwoCaptchaApiKey, UpdateSourceTrigger=PropertyChanged}"/>
                    </StackPanel>
                </Border>

            </StackPanel>
        </ScrollViewer>

        <!-- Action bar -->
        <DockPanel Grid.Row="2" Margin="0,16,0,0" LastChildFill="False">
            <Button Content="Enregistrer" Command="{Binding SaveCommand}" DockPanel.Dock="Left" Margin="0,0,10,0"/>
            <Button Content="Recharger" Style="{StaticResource Ghost}" Command="{Binding ReloadCommand}" DockPanel.Dock="Left"/>
            <TextBlock Text="{Binding StatusText}" Style="{StaticResource Caption}" DockPanel.Dock="Right"
                       VerticalAlignment="Center" TextWrapping="Wrap" MaxWidth="560" TextAlignment="Right"/>
        </DockPanel>
    </Grid>
</UserControl>
