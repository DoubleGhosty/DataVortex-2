<UserControl x:Class="DataVortex.App.Views.DashboardView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:controls="clr-namespace:DataVortex.App.Controls"
             FontFamily="Segoe UI"
             TextElement.Foreground="{DynamicResource TextPrimary}">

    <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="24">
        <StackPanel>
            <TextBlock Text="Dashboard" Style="{StaticResource Title}" Margin="0,0,0,4"/>
            <TextBlock Text="{Binding ExtractFilterText}" Style="{StaticResource Caption}" Margin="0,0,0,20"/>

            <!-- Hero status card -->
            <Border Style="{StaticResource Card}" Margin="0,0,0,16">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <StackPanel Grid.Column="0" VerticalAlignment="Center">
                        <StackPanel Orientation="Horizontal">
                            <Ellipse Width="12" Height="12" VerticalAlignment="Center"
                                     Fill="{Binding Connection, Converter={StaticResource StatusBrush}}"/>
                            <TextBlock Text="{Binding ConnectionText}" Margin="10,0,0,0" FontSize="20" FontWeight="SemiBold"
                                       Foreground="{DynamicResource TextPrimary}" VerticalAlignment="Center"/>
                        </StackPanel>
                        <TextBlock Text="{Binding WatchedChannelCount, StringFormat='{}{0} channels watched'}"
                                   Style="{StaticResource Caption}" Margin="22,6,0,0"/>
                    </StackPanel>
                    <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                        <Border Style="{StaticResource StatusBadge}" Margin="0,0,8,0">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="&#xE896;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" FontSize="12"
                                           Foreground="{DynamicResource Accent}" VerticalAlignment="Center" Margin="0,0,6,0"/>
                                <TextBlock Text="{Binding ActiveDownloads}" FontSize="14" FontWeight="Bold"
                                           Foreground="{DynamicResource Accent}" VerticalAlignment="Center"/>
                                <TextBlock Text=" active" FontSize="12" Foreground="{DynamicResource TextSecondary}"
                                           VerticalAlignment="Center"/>
                            </StackPanel>
                        </Border>
                        <Button Content="{Binding BackfillToggleLabel}" Style="{StaticResource Ghost}"
                                Command="{Binding ToggleBackfillCommand}" VerticalAlignment="Center" Padding="12,7"/>
                    </StackPanel>
                </Grid>
            </Border>

            <!-- KPI stat strip -->
            <UniformGrid Columns="4" Margin="0,0,0,16">
                <Border Style="{StaticResource Card}" Margin="0,0,10,0">
                    <StackPanel>
                        <TextBlock Text="DOWNLOAD QUEUE" Style="{StaticResource MetricLabel}"/>
                        <TextBlock Text="{Binding DownloadQueueDepth}" Style="{StaticResource Metric}" Margin="0,6,0,0"
                                   Foreground="{DynamicResource Cyan}"/>
                    </StackPanel>
                </Border>
                <Border Style="{StaticResource Card}" Margin="0,0,10,0">
                    <StackPanel>
                        <TextBlock Text="PROCESSING QUEUE" Style="{StaticResource MetricLabel}"/>
                        <TextBlock Text="{Binding ProcessingQueueDepth}" Style="{StaticResource Metric}" Margin="0,6,0,0"/>
                    </StackPanel>
                </Border>
                <Border Style="{StaticResource Card}" Margin="0,0,10,0">
                    <StackPanel>
                        <TextBlock Text="FILES PROCESSED" Style="{StaticResource MetricLabel}"/>
                        <TextBlock Text="{Binding TotalFilesProcessed}" Style="{StaticResource Metric}" Margin="0,6,0,0"
                                   Foreground="{DynamicResource Success}"/>
                    </StackPanel>
                </Border>
                <Border Style="{StaticResource Card}">
                    <StackPanel>
                        <TextBlock Text="DATA DOWNLOADED" Style="{StaticResource MetricLabel}"/>
                        <TextBlock Text="{Binding TotalBytesDownloaded, Converter={StaticResource Bytes}}"
                                   Style="{StaticResource Metric}" Margin="0,6,0,0"/>
                    </StackPanel>
                </Border>
            </UniformGrid>

            <!-- Throughput graphs -->
            <Grid Margin="0,0,0,16">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <Border Grid.Column="0" Style="{StaticResource Card}" Margin="0,0,10,0">
                    <StackPanel>
                        <DockPanel>
                            <TextBlock Text="DOWNLOAD SPEED" Style="{StaticResource MetricLabel}" DockPanel.Dock="Left"/>
                            <TextBlock Text="{Binding DownloadSpeedText}" FontSize="22" FontWeight="Bold"
                                       FontFamily="JetBrains Mono, Cascadia Mono, Consolas"
                                       Foreground="{DynamicResource Cyan}" HorizontalAlignment="Right"/>
                        </DockPanel>
                        <controls:Sparkline Height="100" Margin="0,12,0,0"
                                            Values="{Binding DownloadSeries}"
                                            Stroke="{DynamicResource Cyan}"
                                            AutoGradientFill="True"
                                            StrokeThickness="2"/>
                    </StackPanel>
                </Border>

                <Border Grid.Column="1" Style="{StaticResource Card}">
                    <StackPanel>
                        <DockPanel>
                            <TextBlock Text="EXTRACTED / SEC" Style="{StaticResource MetricLabel}" DockPanel.Dock="Left"/>
                            <TextBlock Text="{Binding ExtractedFilesPerSecond}" FontSize="22" FontWeight="Bold"
                                       FontFamily="JetBrains Mono, Cascadia Mono, Consolas"
                                       Foreground="{DynamicResource Success}" HorizontalAlignment="Right"/>
                        </DockPanel>
                        <controls:Sparkline Height="100" Margin="0,12,0,0"
                                            Values="{Binding ProcessingSeries}"
                                            Stroke="{DynamicResource Success}"
                                            AutoGradientFill="True"
                                            StrokeThickness="2"/>
                    </StackPanel>
                </Border>
            </Grid>

            <!-- Secondary metrics -->
            <UniformGrid Columns="4" Margin="0,0,0,16">
                <Border Style="{StaticResource Card}" Margin="0,0,10,0">
                    <StackPanel>
                        <TextBlock Text="FILES DOWNLOADED" Style="{StaticResource MetricLabel}"/>
                        <TextBlock Text="{Binding TotalFilesDownloaded}" Style="{StaticResource Metric}" Margin="0,6,0,0"/>
                    </StackPanel>
                </Border>
                <Border Style="{StaticResource Card}" Margin="0,0,10,0">
                    <StackPanel>
                        <TextBlock Text="WATCHED CHANNELS" Style="{StaticResource MetricLabel}"/>
                        <TextBlock Text="{Binding WatchedChannelCount}" Style="{StaticResource Metric}" Margin="0,6,0,0"
                                   Foreground="{DynamicResource Accent}"/>
                    </StackPanel>
                </Border>
                <Border Style="{StaticResource Card}" Margin="0,0,10,0">
                    <StackPanel>
                        <TextBlock Text="BACKFILL" Style="{StaticResource MetricLabel}"/>
                        <TextBlock Text="{Binding BackfillStateText}" FontSize="16" FontWeight="SemiBold" Margin="0,6,0,0"
                                   Foreground="{DynamicResource Accent}"/>
                        <TextBlock Text="{Binding BackfillDetail}" Style="{StaticResource Caption}" Margin="0,2,0,0"/>
                    </StackPanel>
                </Border>
                <Border Style="{StaticResource Card}">
                    <StackPanel>
                        <TextBlock Text="ACTIVE DOWNLOADS" Style="{StaticResource MetricLabel}"/>
                        <TextBlock Text="{Binding ActiveDownloads}" Style="{StaticResource Metric}" Margin="0,6,0,0"
                                   Foreground="{DynamicResource Cyan}"/>
                    </StackPanel>
                </Border>
            </UniformGrid>

            <!-- Live log -->
            <Border Style="{StaticResource Card}">
                <StackPanel>
                    <TextBlock Text="LIVE LOG" Style="{StaticResource MetricLabel}" Margin="0,0,0,10"/>
                    <ScrollViewer Height="200" VerticalScrollBarVisibility="Auto">
                        <ItemsControl ItemsSource="{Binding Log.Entries}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Grid Margin="0,2">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="68"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Grid.Column="0" Text="{Binding Timestamp, StringFormat=HH:mm:ss}"
                                                   FontFamily="JetBrains Mono, Cascadia Mono, Consolas" FontSize="11"
                                                   Foreground="{DynamicResource Muted}"/>
                                        <TextBlock Grid.Column="1" Text="{Binding Level}"
                                                   FontFamily="JetBrains Mono, Cascadia Mono, Consolas" FontSize="11"
                                                   Margin="10,0"
                                                   Foreground="{Binding Level, Converter={StaticResource StatusBrush}}"/>
                                        <TextBlock Grid.Column="2" Text="{Binding Message}"
                                                   FontFamily="JetBrains Mono, Cascadia Mono, Consolas" FontSize="11"
                                                   TextTrimming="CharacterEllipsis" Foreground="{DynamicResource TextSecondary}"/>
                                    </Grid>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>
                </StackPanel>
            </Border>
        </StackPanel>
    </ScrollViewer>
</UserControl>
