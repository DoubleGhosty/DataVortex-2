<UserControl x:Class="DataVortex.App.Views.DashboardView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:controls="clr-namespace:DataVortex.App.Controls"
             FontFamily="Segoe UI"
             TextElement.Foreground="{DynamicResource TextPrimary}">

    <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="24">
        <StackPanel>

            <!-- Header -->
            <DockPanel Margin="0,0,0,20">
                <TextBlock Text="Dashboard" Style="{StaticResource Title}" DockPanel.Dock="Left" VerticalAlignment="Center"/>
                <Button Content="{Binding BackfillToggleLabel}" Style="{StaticResource Ghost}"
                        Command="{Binding ToggleBackfillCommand}" DockPanel.Dock="Right"
                        HorizontalAlignment="Right" VerticalAlignment="Center"
                        ToolTip="Backfill scans watched channels' history for old archives when the pipeline is idle."/>
            </DockPanel>

            <!-- Status band -->
            <Border Style="{StaticResource Card}" Margin="0,0,0,14">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <StackPanel Grid.Column="0" VerticalAlignment="Center">
                        <StackPanel Orientation="Horizontal">
                            <Ellipse Width="11" Height="11" VerticalAlignment="Center"
                                     Fill="{Binding Connection, Converter={StaticResource StatusBrush}}"/>
                            <TextBlock Text="{Binding ConnectionText}" Margin="10,0,0,0" FontSize="17" FontWeight="SemiBold"
                                       Foreground="{DynamicResource TextPrimary}" VerticalAlignment="Center"/>
                        </StackPanel>
                        <StackPanel Orientation="Horizontal" Margin="21,5,0,0">
                            <TextBlock Text="{Binding WatchedChannelCount, StringFormat='{}{0} channels watched'}"
                                       Style="{StaticResource Caption}"/>
                            <TextBlock Text="  ·  " Style="{StaticResource Caption}"/>
                            <TextBlock Text="{Binding BackfillStateText, StringFormat='backfill {0}'}"
                                       Style="{StaticResource Caption}"/>
                        </StackPanel>
                    </StackPanel>
                    <Border Grid.Column="1" Style="{StaticResource StatusBadge}" VerticalAlignment="Center"
                            CornerRadius="20" Padding="12,6">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="&#xE896;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" FontSize="12"
                                       Foreground="{DynamicResource Accent}" VerticalAlignment="Center" Margin="0,0,7,0"/>
                            <TextBlock Text="{Binding ActiveDownloads}" FontSize="14" FontWeight="Bold"
                                       Foreground="{DynamicResource Accent}" VerticalAlignment="Center"/>
                            <TextBlock Text=" active downloads" FontSize="12" Foreground="{DynamicResource TextSecondary}"
                                       VerticalAlignment="Center"/>
                        </StackPanel>
                    </Border>
                </Grid>
            </Border>

            <!-- KPI stat strip -->
            <UniformGrid Columns="4" Margin="0,0,0,14">
                <Border Style="{StaticResource Card}" Margin="0,0,10,0">
                    <StackPanel>
                        <TextBlock Text="DOWNLOAD QUEUE" Style="{StaticResource MetricLabel}"/>
                        <TextBlock Text="{Binding DownloadQueueDepth}" Style="{StaticResource Metric}" Margin="0,6,0,0"
                                   Foreground="{DynamicResource Accent}"/>
                    </StackPanel>
                </Border>
                <Border Style="{StaticResource Card}" Margin="0,0,10,0">
                    <StackPanel>
                        <TextBlock Text="PROCESSING QUEUE" Style="{StaticResource MetricLabel}"/>
                        <TextBlock Text="{Binding ProcessingQueueDepth}" Style="{StaticResource Metric}" Margin="0,6,0,0"/>
                    </StackPanel>
                </Border>
                <Border Style="{StaticResource Card}" Margin="0,0,10,0">
                    <StackPanel>
                        <TextBlock Text="FILES PROCESSED" Style="{StaticResource MetricLabel}"/>
                        <TextBlock Text="{Binding TotalFilesProcessed}" Style="{StaticResource Metric}" Margin="0,6,0,0"
                                   Foreground="{DynamicResource Success}"/>
                    </StackPanel>
                </Border>
                <Border Style="{StaticResource Card}">
                    <StackPanel>
                        <TextBlock Text="DATA DOWNLOADED" Style="{StaticResource MetricLabel}"/>
                        <TextBlock Text="{Binding TotalBytesDownloaded, Converter={StaticResource Bytes}}"
                                   Style="{StaticResource Metric}" Margin="0,6,0,0"/>
                    </StackPanel>
                </Border>
            </UniformGrid>

            <!-- Throughput graphs -->
            <Grid Margin="0,0,0,14">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <Border Grid.Column="0" Style="{StaticResource Card}" Margin="0,0,10,0">
                    <StackPanel>
                        <DockPanel>
                            <TextBlock Text="DOWNLOAD SPEED" Style="{StaticResource MetricLabel}" DockPanel.Dock="Left"/>
                            <TextBlock Text="{Binding DownloadSpeedText}" FontSize="22" FontWeight="Bold"
                                       FontFamily="JetBrains Mono, Cascadia Mono, Consolas"
                                       Foreground="{DynamicResource Accent}" HorizontalAlignment="Right"/>
                        </DockPanel>
                        <controls:Sparkline Height="100" Margin="0,12,0,0"
                                            Values="{Binding DownloadSeries}"
                                            Stroke="{DynamicResource Accent}"
                                            AutoGradientFill="True"
                                            StrokeThickness="2"/>
                    </StackPanel>
                </Border>

                <Border Grid.Column="1" Style="{StaticResource Card}">
                    <StackPanel>
                        <DockPanel>
                            <TextBlock Text="EXTRACTED / SEC" Style="{StaticResource MetricLabel}" DockPanel.Dock="Left"/>
                            <TextBlock Text="{Binding ExtractedFilesPerSecond}" FontSize="22" FontWeight="Bold"
                                       FontFamily="JetBrains Mono, Cascadia Mono, Consolas"
                                       Foreground="{DynamicResource Success}" HorizontalAlignment="Right"/>
                        </DockPanel>
                        <controls:Sparkline Height="100" Margin="0,12,0,0"
                                            Values="{Binding ProcessingSeries}"
                                            Stroke="{DynamicResource Success}"
                                            AutoGradientFill="True"
                                            StrokeThickness="2"/>
                    </StackPanel>
                </Border>
            </Grid>

            <!-- Live log -->
            <Border Style="{StaticResource Card}">
                <StackPanel>
                    <TextBlock Text="LIVE LOG" Style="{StaticResource MetricLabel}" Margin="0,0,0,10"/>
                    <ScrollViewer Height="200" VerticalScrollBarVisibility="Auto">
                        <ItemsControl ItemsSource="{Binding Log.Entries}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Grid Margin="0,2">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="68"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Grid.Column="0" Text="{Binding Timestamp, StringFormat=HH:mm:ss}"
                                                   FontFamily="JetBrains Mono, Cascadia Mono, Consolas" FontSize="11"
                                                   Foreground="{DynamicResource Muted}"/>
                                        <TextBlock Grid.Column="1" Text="{Binding Level}"
                                                   FontFamily="JetBrains Mono, Cascadia Mono, Consolas" FontSize="11"
                                                   Margin="10,0"
                                                   Foreground="{Binding Level, Converter={StaticResource StatusBrush}}"/>
                                        <TextBlock Grid.Column="2" Text="{Binding Message}"
                                                   FontFamily="JetBrains Mono, Cascadia Mono, Consolas" FontSize="11"
                                                   TextTrimming="CharacterEllipsis" Foreground="{DynamicResource TextSecondary}"/>
                                    </Grid>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>
                </StackPanel>
            </Border>
        </StackPanel>
    </ScrollViewer>
</UserControl>
